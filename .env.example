NEXT_PUBLIC_SITE_URL=https://traitbridge.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Public Cloudflare Turnstile site key. Keep the matching secret only in Supabase Auth settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_cloudflare_turnstile_site_key
# V2 is disabled until staging validation, migration and explicit beta invitations.
TRAITBRIDGE_V2_ENABLED=false
# Server only. NEVER add a NEXT_PUBLIC_ prefix or commit real keys.
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
